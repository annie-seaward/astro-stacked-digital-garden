---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Digital Garden' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />
  <script is:inline>
    function applyStoredTheme(el) {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        el.classList.add('dark');
      } else {
        el.classList.remove('dark');
      }
    }
    applyStoredTheme(document.documentElement);
    document.addEventListener('astro:before-swap', e => applyStoredTheme(e.newDocument.documentElement));
  </script>
</head>
<body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen">
  <slot />
</body>
</html>
